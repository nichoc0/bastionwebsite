---
import Base from '../layouts/Base.astro'
import { pieces } from '../data/research'
---

<Base
  title="Research · Bastion"
  description="How classes of AI agents fail, written from the builder's side. Each pattern ends with a check you can run against your own system."
>
  <section class="top">
    <div class="glow" aria-hidden="true"></div>
    <div class="page">
      <p class="label">Failure patterns</p>
      <h1>Research</h1>
      <p class="lede">
        Here is a hole that is probably in your system. Patterns we keep
        finding, each ending with a check you can run today.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="page">
      <ol class="index">
        {
          pieces.map((p, i) => (
            <li>
              <a href={`/research/${p.slug}`}>
                <header>
                  <span class="idx tnum">{String(i + 1).padStart(2, '0')}</span>
                  <span class="code">{p.code}</span>
                  <span class="klass">{p.klass}</span>
                  <time class="date tnum" datetime={p.published}>
                    {p.published}
                  </time>
                </header>
                <h2>{p.title}</h2>
                <p class="hook">{p.hook}</p>
                <span class="go">Read it →</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<style>
  .top {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 7vw, 6rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .glow {
    position: absolute;
    inset: -40% -20% auto -20%;
    height: 190%;
    z-index: -1;
    background: radial-gradient(
      44% 46% at 30% 0%,
      rgba(255, 240, 206, 0.28) 0%,
      rgba(16, 15, 13, 0) 68%
    );
    filter: blur(26px);
  }

  h1 {
    font-size: clamp(2rem, 1.25rem + 3vw, 3.4rem);
    margin-block: 1.1rem 1.3rem;
    max-width: 20ch;
  }

  .index {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .index li {
    border-top: 1px solid var(--stone-line);
  }

  .index li:first-child {
    border-top: 0;
  }

  .index a {
    display: block;
    max-width: 68ch;
    padding-block: clamp(1.75rem, 3.5vw, 2.5rem);
    text-decoration: none;
  }

  header {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    margin-bottom: 0.8rem;
    max-width: 68ch;
  }

  .idx {
    font-size: 0.76rem;
    color: var(--muted);
  }

  .code {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--gold-text);
  }

  .klass {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .date {
    margin-left: auto;
    font-size: 0.78rem;
    color: var(--muted);
  }

  h2 {
    font-size: clamp(1.35rem, 1.05rem + 1.2vw, 1.9rem);
    max-width: 24ch;
    transition: color 150ms ease;
  }

  .index a:hover h2 {
    color: var(--gold-text);
  }

  .hook {
    margin-top: 0.8rem;
    font-size: clamp(1rem, 0.97rem + 0.3vw, 1.15rem);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .go {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--gold-text);
  }
</style>
