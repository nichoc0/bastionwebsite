---
import Base from '../../layouts/Base.astro'
import { pieces } from '../../data/research'

export function getStaticPaths() {
  return pieces.map((p) => ({ params: { slug: p.slug }, props: { piece: p } }))
}

const { piece } = Astro.props
---

<Base title={`${piece.title} · Bastion`} description={piece.hook}>
  <article class="page piece">
    <header>
      <a class="back" href="/research">← Research</a>
      <p class="meta">
        <span class="code">{piece.code}</span>
        <span class="klass">{piece.klass}</span>
        <time class="date tnum" datetime={piece.published}>{piece.published}</time>
      </p>
      <h1>{piece.title}</h1>
      <p class="byline">{piece.byline}</p>
    </header>

    <p class="hook">{piece.hook}</p>

    {
      piece.found && (
        <aside class="found">
          <span class="found-label">From an engagement</span>
          <p>{piece.found}</p>
        </aside>
      )
    }

    {piece.body.map((b) => <p class="para">{b}</p>)}

    <footer>
      <a class="btn btn-primary" href="/contact">See how it fails</a>
      <a class="btn btn-quiet" href="/research">All patterns</a>
    </footer>
  </article>
</Base>

<style>
  .piece {
    max-width: calc(68ch + 2 * var(--gutter));
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .back {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 1.75rem;
  }

  .back:hover {
    color: var(--gold-text);
  }

  .meta {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    margin-bottom: 0.9rem;
  }

  .code {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--gold-text);
    text-transform: uppercase;
  }

  .klass {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .date {
    font-size: 0.78rem;
    color: var(--muted);
  }

  h1 {
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 2.7rem);
    max-width: 24ch;
  }

  .byline {
    margin-top: 0.8rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .hook {
    margin-top: 1.5rem;
    font-size: clamp(1.05rem, 1rem + 0.35vw, 1.2rem);
    line-height: 1.55;
    color: var(--ink);
    padding-left: 1.1rem;
    border-left: 2px solid var(--gold);
  }

  .found {
    margin-top: 1.25rem;
    padding: 0.95rem 1.15rem;
    background: var(--panel);
    border: 1px solid var(--stone-line);
    border-radius: 3px;
  }

  .found-label {
    display: block;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-text);
    margin-bottom: 0.4rem;
  }

  .found p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .para {
    margin-top: 1.05rem;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--ink-2);
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--stone-line);
  }
</style>
