---
import Base from '../layouts/Base.astro'
import Hero from '../components/Hero.astro'
import Prism from '../components/Prism.astro'
import Failures from '../components/Failures.astro'
import Engagements from '../components/Engagements.astro'
import ProofBand from '../components/ProofBand.astro'
import HowAgentsFail from '../components/HowAgentsFail.astro'
import HowItWorks from '../components/HowItWorks.astro'
import Evidence from '../components/Evidence.astro'
import Pipeline from '../components/Pipeline.astro'
import AgentTypes from '../components/AgentTypes.astro'
---

<Base
  title="Bastion. We know how AI agents fail"
  description="The independent record of how AI agents fail. Every failure we find, across security and reliability, compounds into knowledge you cannot build in-house, because you have only ever seen your own agents."
>
  <!-- Order: proof of what we do first, the machine second, industry context
       last. Other people's incidents close the page, they do not open it. -->
  <Hero />
  <ProofBand />
  <Engagements />

  <!-- the moment the reader goes from "they found things" to "they built
       something". The console stands alone, straight after the cases. -->
  <section class="run-band">
    <div class="page">
      <figure class="run-shot">
        <img
          src="/assets/shot-run.webp"
          width="1800"
          height="1125"
          alt="A run in the Bastion console: 128 turns, 4 agents, 5 findings, each mapped to an OWASP class."
          loading="lazy"
          decoding="async"
        />
        <figcaption class="muted tnum">
          One run. 128 turns, 4 agents, 5 findings, each mapped to its OWASP class.
        </figcaption>
      </figure>
    </div>
  </section>

  <HowItWorks />
  <AgentTypes />
  <HowAgentsFail />
  <section class="prism-band">
    <div class="page">
      <h2 class="prism-h">Twelve mechanisms behind how agents actually fail</h2>
      <Prism />
    </div>
  </section>
  <Evidence />
  <Pipeline />
  <Failures />
</Base>

<style>
  .prism-band {
    padding-block: clamp(2.75rem, 5vw, 4.5rem);
    border-bottom: 1px solid var(--stone-line);
    overflow: hidden;
  }

  .prism-h {
    font-size: clamp(1.5rem, 1.1rem + 1.7vw, 2.3rem);
    max-width: 24ch;
    margin-block: 1rem 1.75rem;
  }

  .run-band {
    padding-block: clamp(2.75rem, 5vw, 4.5rem);
    border-bottom: 1px solid var(--stone-line);
  }

  .run-shot {
    margin: 0;
  }

  .run-shot img {
    width: 100%;
    height: auto;
    border: 1px solid var(--stone-line);
    border-radius: 3px;
    box-shadow:
      0 1px 2px rgba(25, 23, 19, 0.04),
      0 18px 48px -20px rgba(25, 23, 19, 0.24);
  }

  .run-shot figcaption {
    margin-top: 0.9rem;
    font-family: var(--sans);
    font-size: 0.76rem;
  }
</style>
