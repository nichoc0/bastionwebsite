---
import { families, familyMax } from '../data/taxonomy'

const top = families.slice(0, 5)
const total = top.reduce((n, f) => n + f.count, 0)
const R = 108
const CIRC = 2 * Math.PI * R
let acc = 0
const arcs = top.map((f, i) => {
  const frac = f.count / total
  const seg = { ...f, dash: frac * CIRC, offset: -acc * CIRC, i }
  acc += frac
  return seg
})
// five stops that actually separate. --sp-3/4/5 are all blues, which made
// three of the five segments unreadable against each other.
const SPECTRUM = ['#e0a941', '#c2ac57', '#6faf93', '#4f93c4', '#8fc8f5']

// The security list leads and runs deeper than reliability on purpose.
// Security buyers read this section first, and the extra classes are the
// ones the taxonomy actually holds (see data/taxonomy.ts).
const security = [
  'Data leaks',
  'Prompt injection',
  'Tool abuse',
  'Cross-tenant access',
  'Auth bypass',
  'Agent-runtime exfiltration',
  'MCP and tool-layer attacks',
  'Server-side request forgery',
]

const reliability = [
  'Wrong action taken',
  'Off-policy behavior',
  'Instruction drift',
  'Confident wrong answers',
]

const properties = [
  { term: 'Independent', def: 'We sit outside the deal and run the attacks ourselves' },
  { term: 'Compounding', def: 'Every engagement writes back, so the next one starts ahead' },
  { term: 'Field-wide', def: 'Patterns travel between engagements. Your data stays yours' },
]
---

<section class="section" id="how-agents-fail">
  <div class="page">
    <p class="label">How agents fail</p>

    <h2>
      Every way an agent can fail, security or reliability, becomes structured
      knowledge
    </h2>

    <div class="columns">
      <div class="col sec">
        <h3>Security failures <span class="sub">The primary product</span></h3>
        <ul class="two-up">{security.map((s) => <li>{s}</li>)}</ul>
      </div>

      <div class="col">
        <h3>Reliability failures <span class="sub">Included in the same record</span></h3>
        <ul>{reliability.map((s) => <li>{s}</li>)}</ul>
      </div>
    </div>

    <p class="one-dataset">
      Both live in one dataset. Security first, reliability included.
    </p>

    <figure class="corpus">
      <figcaption class="label">Where the depth sits</figcaption>

      <div class="ring">
        <svg viewBox="0 0 260 260" role="img" aria-label="Share of corpus depth by failure class">
          {
            arcs.map((a) => (
              <circle
                cx="130" cy="130" r={R}
                fill="none"
                stroke={SPECTRUM[a.i]}
                stroke-width="30"
                stroke-dasharray={`${a.dash} ${CIRC - a.dash}`}
                stroke-dashoffset={a.offset}
                transform="rotate(-90 130 130)"
              />
            ))
          }
          <text x="130" y="123" class="tot tnum">{total}</text>
          <text x="130" y="145" class="totl">techniques</text>
        </svg>

        <ul class="key">
          {
            arcs.map((a) => (
              <li>
                <span class="swatch" style={`background:${SPECTRUM[a.i]}`} />
                <span class="k-label">{a.label}</span>
                <span class="k-count tnum">{a.count}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </figure>

    <dl class="properties">
      {
        properties.map((p) => (
          <div>
            <dt>{p.term}</dt>
            <dd>{p.def}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  h2 {
    font-size: clamp(1.85rem, 1.2rem + 2.5vw, 3rem);
    max-width: 30ch;
    margin-block: 1.1rem clamp(2.75rem, 6vw, 4.25rem);
  }

  /* security carries the weight, reliability rides along */
  .columns {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: clamp(1.75rem, 5vw, 4.5rem);
  }

  .two-up {
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(1.25rem, 3vw, 2.5rem);
  }

  .sub {
    display: block;
    margin-top: 0.35rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .col {
    border-top: 1px solid var(--stone-line);
    padding-top: 1.35rem;
  }

  .col h3 {
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 1.1rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }

  .col li {
    font-size: clamp(1.05rem, 1rem + 0.45vw, 1.3rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--ink-2);
    padding-left: 1.15rem;
    position: relative;
  }

  .col li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 1px;
    background: var(--gold);
  }

  .one-dataset {
    margin-top: clamp(2.25rem, 4vw, 3.25rem);
    font-family: var(--display);
    font-weight: 500;
    letter-spacing: -0.035em;
    font-size: clamp(1.35rem, 1.1rem + 1vw, 2rem);
    color: var(--ink);
  }

  .corpus {
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: clamp(1.4rem, 3vw, 2rem);
    background: var(--bone-lift);
    border: 1px solid var(--stone-line);
  }

  figcaption {
    padding-bottom: 1rem;
    margin-bottom: 1.35rem;
    border-bottom: 1px solid var(--stone-line);
  }

  .ring {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-top: 1.4rem;
  }

  .ring svg {
    width: clamp(180px, 22vw, 250px);
    height: auto;
  }

  .tot {
    text-anchor: middle;
    font-family: var(--sans);
    font-size: 40px;
    font-weight: 600;
    letter-spacing: -0.03em;
    fill: var(--ink);
  }

  .totl {
    text-anchor: middle;
    font-family: var(--sans);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    fill: var(--muted);
  }

  .key {
    display: grid;
    gap: 0.7rem;
  }

  .key li {
    display: grid;
    grid-template-columns: 0.6rem 1fr auto;
    align-items: center;
    gap: 0.85rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--stone-line);
  }

  .key li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .swatch {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
  }

  .k-label {
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  .k-count {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink);
  }

  .properties {
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3.5vw, 3rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--stone-line);
  }

  dt {
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-text);
    margin-bottom: 0.6rem;
  }

  dd {
    margin: 0;
    font-size: 0.985rem;
    line-height: 1.55;
    color: var(--ink-2);
  }

  @media (max-width: 820px) {
    .columns,
    .properties,
    .two-up {
      grid-template-columns: 1fr;
    }
    .ring {
      grid-template-columns: 1fr;
      justify-items: center;
    }
  }
</style>
