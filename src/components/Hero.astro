---
// Architecture borrowed from the sites that actually hold attention:
// a full-bleed environment you are standing inside, one claim, one action,
// and the product bleeding up into the scene and cut off by the fold, so the
// only way to finish the picture is to scroll.
import { corpus } from '../data/dataset'

const items = corpus.items.toLocaleString('en-US')
const links = corpus.links.toLocaleString('en-US')
---

<section class="hero">
  <div class="sky" aria-hidden="true"></div>
  <div class="rays" aria-hidden="true"></div>
  <div class="split" aria-hidden="true"></div>
  <div class="massif" aria-hidden="true"></div>
  <div class="deck" aria-hidden="true"></div>
  <div class="fore" aria-hidden="true"></div>

  <div class="page inner">
    <p class="label rise d1">The independent record of how AI agents fail</p>

    <h1 class="rise d2">
      We know how AI agents fail.<br />
      <span class="turn">So you can trust the ones you ship.</span>
    </h1>

    <p class="lede rise d3">
      Every failure we find, across security and reliability, becomes part of one
      independent record that compounds with every run.
    </p>

    <p class="counter rise d4">
      You have only ever seen your own agents break. We have seen everyone’s.
    </p>

    <div class="actions rise d5">
      <!-- the input is the hook. it carries the domain into the contact form. -->
      <form class="start" action="/contact" method="GET">
        <input
          type="text"
          name="domain"
          placeholder="your domain"
          aria-label="Your domain"
          autocomplete="off"
          spellcheck="false"
        />
        <button class="btn btn-primary" type="submit">See how it fails</button>
      </form>
      <a class="btn btn-quiet" href="#how-agents-fail">What we find</a>
    </div>

    <p class="start-note rise d5">Prefills the contact form with your domain.</p>
  </div>

  <!-- the product, cut off by the fold -->
  <div class="stage rise d5">
    <div class="frame">
      <video
        class="reel"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="/assets/shot-cortex.webp"
        width="1440"
        height="900"
        aria-label="The corpus being browsed: vulnerability classes, then the OWASP LLM Top 10."
      >
        <source src="/assets/cortex-tour.webm" type="video/webm" />
        <source src="/assets/cortex-tour.mp4" type="video/mp4" />
      </video>
      <img
        class="still"
        src="/assets/shot-cortex.webp"
        width="1800"
        height="1125"
        alt={`The Bastion corpus: ${items} items and ${links} links.`}
        decoding="async"
      />
    </div>
    <p class="corpus-line">
      <a href="/corpus"
        ><span class="tnum">{items}</span> items · <span class="tnum">{links}</span> links ·
        compounds every run</a
      >
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: clamp(2.5rem, 5vw, 4.25rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    text-align: center;
  }

  /* SOURCE. off-centre, upper right, blown out at the core and falling away
     fast. the reference never lights anything evenly. */
  .sky {
    position: absolute;
    inset: 0;
    z-index: -4;
    background:
      radial-gradient(
        40% 46% at 76% -8%,
        rgba(255, 250, 232, 1) 0%,
        rgba(255, 226, 168, 0.9) 16%,
        rgba(224, 160, 74, 0.55) 33%,
        rgba(120, 84, 52, 0.22) 54%,
        rgba(20, 19, 18, 0) 74%
      ),
      radial-gradient(
        76% 56% at 88% 2%,
        rgba(232, 158, 70, 0.34) 0%,
        rgba(232, 158, 70, 0) 62%
      ),
      linear-gradient(
        166deg,
        #14140f 0%,
        #1b1a15 26%,
        #24211a 48%,
        #2c2820 70%,
        #35301f 100%
      );
  }

  /* volumetric shafts, fanning down-left from the source. you see the light
     in the air, not just where it lands. */
  .rays {
    position: absolute;
    inset: -20% -20% auto -20%;
    height: 150%;
    z-index: -3;
    transform: rotate(-34deg);
    transform-origin: 78% 0;
    opacity: 0.75;
    background: repeating-linear-gradient(
      90deg,
      rgba(255, 244, 214, 0) 0px,
      rgba(255, 244, 214, 0.34) 18px,
      rgba(255, 240, 200, 0.5) 34px,
      rgba(255, 244, 214, 0) 70px,
      rgba(255, 244, 214, 0) 148px
    );
    filter: blur(16px);
    mask-image: radial-gradient(
      58% 62% at 76% 6%,
      #000 0%,
      rgba(0, 0, 0, 0.55) 40%,
      transparent 78%
    );
  }

  /* the dispersion sitting in the cloud, the same one the reference has */
  .split {
    position: absolute;
    top: 26%;
    right: -6%;
    width: 58%;
    height: 58%;
    z-index: -3;
    opacity: 0.34;
    background: linear-gradient(
      102deg,
      rgba(184, 134, 47, 0) 26%,
      rgba(197, 143, 52, 0.5) 38%,
      rgba(139, 140, 96, 0.4) 47%,
      rgba(58, 118, 168, 0.36) 56%,
      rgba(30, 111, 217, 0.3) 63%,
      rgba(111, 178, 240, 0.22) 70%,
      rgba(111, 178, 240, 0) 84%
    );
    filter: blur(40px);
  }

  /* MOUNTAIN. dark, hard-edged, asymmetric, cropped by the frame so it carries
     on out of view. the only sharp thing on the page, and the dark the light
     needs in order to read as bright. */
  .massif {
    position: absolute;
    left: -8%;
    bottom: -2%;
    width: 62%;
    height: 78%;
    z-index: -3;
    opacity: 0.9;
    filter: blur(5px);
    background: linear-gradient(
      158deg,
      rgba(8, 8, 7, 0.92) 0%,
      rgba(14, 13, 11, 0.78) 40%,
      rgba(22, 20, 17, 0.5) 74%,
      rgba(30, 27, 22, 0) 100%
    );
    mask-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.85) 0%,
      rgba(0, 0, 0, 0.5) 46%,
      transparent 82%
    );
    clip-path: polygon(
      0% 100%, 0% 34%, 7% 22%, 13% 31%, 21% 6%,
      27% 17%, 33% 9%, 39% 27%, 46% 19%, 53% 41%,
      61% 33%, 70% 55%, 79% 47%, 88% 68%, 100% 62%, 100% 100%
    );
  }

  /* the cloud deck. a sea you are above. it eats the base of everything. */
  .deck {
    position: absolute;
    left: -6%;
    right: -6%;
    bottom: 0;
    height: 62%;
    z-index: -2;
    background:
      radial-gradient(56% 84% at 20% 98%, rgba(226, 178, 108, 0.16) 0%, rgba(226, 178, 108, 0) 60%),
      radial-gradient(52% 78% at 58% 104%, rgba(240, 206, 148, 0.14) 0%, rgba(240, 206, 148, 0) 62%),
      radial-gradient(64% 82% at 86% 100%, rgba(246, 214, 160, 0.13) 0%, rgba(246, 214, 160, 0) 64%),
      linear-gradient(to top, rgba(16, 15, 13, 0.9) 0%, rgba(16, 15, 13, 0.34) 34%, rgba(16, 15, 13, 0) 76%);
    filter: blur(2px);
  }

  /* foreground bank, darker and heavier, so the depth reads as three layers */
  .fore {
    position: absolute;
    left: -10%;
    right: -10%;
    bottom: -6%;
    height: 26%;
    z-index: -1;
    background:
      radial-gradient(52% 100% at 14% 102%, rgba(16, 15, 13, 0.95) 0%, rgba(16, 15, 13, 0) 72%),
      radial-gradient(46% 96% at 72% 106%, rgba(16, 15, 13, 0.9) 0%, rgba(16, 15, 13, 0) 74%);
    filter: blur(14px);
  }

  .inner {
    position: relative;
  }

  /* the rays cross the headline, so the type gets its own ground */
  .inner::before {
    content: '';
    position: absolute;
    inset: -12% -14% -18%;
    z-index: -1;
    background: radial-gradient(
      58% 62% at 46% 46%,
      rgba(16, 15, 12, 0.62) 0%,
      rgba(16, 15, 12, 0.34) 46%,
      rgba(16, 15, 12, 0) 78%
    );
  }

  /* the hero is the one dark room in the building */
  h1 {
    color: #fbf6ea;
  }

  .turn {
    color: rgba(251, 246, 234, 0.88);
  }

  .lede {
    color: rgba(246, 240, 226, 0.86);
  }

  .hero :global(.btn-primary) {
    background: #fbf6ea;
    color: #17150f;
  }

  .hero :global(.btn-primary:hover) {
    background: #fff;
  }

  .hero :global(.btn-quiet) {
    color: rgba(246, 240, 226, 0.72);
  }

  .hero :global(.btn-quiet:hover) {
    color: #f4d79a;
  }

  /* the eyebrow should seat the headline, not compete with it */
  .label {
    display: inline-block;
    color: var(--gold-text);
    font-weight: 500;
    letter-spacing: 0.13em;
  }

  h1 {
    font-size: clamp(2.35rem, 1.1rem + 4.6vw, 4.35rem);
    margin-block: 1.4rem 0;
    margin-inline: auto;
    max-width: 21ch;
  }

  .turn {
    display: block;
    text-wrap: balance;
    color: var(--ink-2);
  }

  .lede {
    margin: 1.6rem auto 0;
    max-width: 54ch;
    text-align: center;
  }

  /* the reason you cannot build this in-house */
  .counter {
    margin: 1.5rem auto 0;
    max-width: 44ch;
    font-size: clamp(1.05rem, 1rem + 0.4vw, 1.3rem);
    line-height: 1.45;
    letter-spacing: -0.02em;
    color: var(--gold-text);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem 1rem;
    justify-content: center;
    margin-top: clamp(1.9rem, 3.5vw, 2.6rem);
  }

  /* one field, then the app takes over. the act of using it is the demo. */
  .start {
    display: flex;
    align-items: stretch;
    gap: 0;
    background: rgba(245, 239, 226, 0.06);
    border: 1px solid rgba(245, 239, 226, 0.22);
    border-radius: 3px;
    padding: 5px;
    backdrop-filter: blur(6px);
    transition: border-color 180ms ease;
  }

  .start:focus-within {
    border-color: var(--gold);
  }

  .start input {
    width: clamp(13rem, 26vw, 20rem);
    background: transparent;
    border: 0;
    outline: 0;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 0.95rem;
    padding: 0 0.9rem;
  }

  .start input::placeholder {
    color: rgba(245, 239, 226, 0.44);
  }

  .start .btn {
    padding-block: 0.7rem;
  }

  @media (max-width: 560px) {
    .start {
      flex-direction: column;
      width: 100%;
    }
    .start input {
      width: 100%;
      padding-block: 0.7rem;
    }
  }

  /* the field looks like it might scan something. it does not, and the page
     says so instead of letting the reader find out on the next screen. */
  .start-note {
    margin-top: 0.7rem;
    font-size: 0.76rem;
    letter-spacing: 0.02em;
    color: rgba(245, 239, 226, 0.48);
  }

  /* the stage crops the product against the fold */
  .stage {
    position: relative;
    margin-top: clamp(2.25rem, 4.5vw, 3.25rem);
    padding-inline: var(--gutter);
    overflow: visible;
  }

  .frame {
    position: relative;
    max-width: 830px;
    margin-inline: auto;
    border: 1px solid var(--stone-line);
    border-radius: 8px;
    overflow: hidden;
    box-shadow:
      0 -1px 0 rgba(255, 255, 255, 0.7) inset,
      0 26px 70px -28px rgba(25, 23, 19, 0.4);
  }

  .frame :is(video, img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* cloud crossing the base of the product, so it emerges from the weather
     instead of sitting on top of it */
  .stage::after {
    content: '';
    position: absolute;
    left: -8%;
    right: -8%;
    bottom: -1px;
    height: 34%;
    pointer-events: none;
    background:
      radial-gradient(46% 100% at 26% 106%, rgba(16, 15, 13, 0.92) 0%, rgba(16, 15, 13, 0) 72%),
      radial-gradient(52% 100% at 74% 108%, rgba(16, 15, 13, 0.9) 0%, rgba(16, 15, 13, 0) 74%),
      linear-gradient(to top, rgba(16, 15, 13, 0.92) 0%, rgba(16, 15, 13, 0) 86%);
    filter: blur(5px);
  }

  /* sits over the cloud that crosses the base of the stage, so it needs
     its own stacking context to stay legible */
  .corpus-line {
    position: relative;
    z-index: 1;
    margin-top: 1.15rem;
    font-size: 0.86rem;
    letter-spacing: 0.04em;
    color: rgba(246, 240, 226, 0.62);
  }

  .corpus-line a {
    text-decoration: none;
  }

  .corpus-line a:hover {
    color: #f4d79a;
  }

  .frame .still {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .reel {
      display: none;
    }
    .frame .still {
      display: block;
    }
  }

  @media (max-width: 720px) {
    .stage {
    }
  }
</style>
