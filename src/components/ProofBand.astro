---
// The Lakera ranking is the strongest external validation on the page, so it
// carries the band: widest column, largest figure. The other two support.
---

<section class="band">
  <div class="page grid">
    <article class="stat lead">
      <p class="value tnum">
        #5
        <span class="scale">of 10,000+</span>
      </p>
      <hr class="rule" />
      <p class="label">Lakera's Agent Breaker leaderboard</p>
    </article>

    <article class="stat">
      <p class="value tnum">
        94%
        <span class="scale">attack success rate</span>
      </p>
      <hr class="rule" />
      <p class="label">AgentHarm, official test split</p>
    </article>

    <article class="stat">
      <p class="value">
        <span class="line">
          <svg viewBox="0 0 64 64" aria-hidden="true" class="wheel">
            <circle cx="32" cy="32" r="23" class="ring" />
            <circle cx="32" cy="32" r="23" class="arc" />
            <circle cx="32" cy="32" r="4.5" class="hub" />
          </svg>
          Continuous
        </span>
        <span class="scale">vulnerability research</span>
      </p>
      <hr class="rule" />
      <p class="label">The corpus compounds every run</p>
    </article>
  </div>
</section>

<style>
  .band {
    background: var(--bone-lift);
    border-block: 1px solid var(--stone-line);
    padding-block: clamp(2.5rem, 4.5vw, 3.75rem);
  }

  /* asymmetric on purpose: the leaderboard rank owns the band */
  .grid {
    display: grid;
    grid-template-columns: 2.6fr 1fr 1fr;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: start;
  }

  .lead .value {
    font-size: clamp(3.4rem, 2.2rem + 4.6vw, 6rem);
  }

  .lead .scale {
    font-size: 1rem;
  }

  .stat {
    display: grid;
    gap: 0.7rem;
    align-content: start;
  }

  .value {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(2.35rem, 1.6rem + 2.6vw, 3.4rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .scale {
    font-family: var(--sans);
    font-size: 0.86rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.35;
    color: var(--muted);
  }

  .label {
    color: var(--muted);
    letter-spacing: 0.14em;
  }

  .line {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .wheel {
    width: 0.82em;
    height: 0.82em;
    flex: none;
  }

  .ring {
    fill: none;
    stroke: var(--stone-line);
    stroke-width: 2;
  }

  .arc {
    fill: none;
    stroke: var(--gold);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 46 99;
    transform-origin: 32px 32px;
    animation: spin 6s linear infinite;
  }

  .hub {
    fill: var(--gold);
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arc {
      animation: none;
    }
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
  }
</style>
