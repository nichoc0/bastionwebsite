---
// The Lakera ranking is the strongest external validation on the page, so it
// carries the band: widest column, largest figure. The other two support.
import { dataset } from '../data/dataset'
---

<section class="band">
  <div class="page grid">
    <article class="stat lead">
      <p class="value tnum">
        #5
        <span class="scale">of 10,000+</span>
      </p>
      <hr class="rule" />
      <p class="label">Lakera's Agent Breaker leaderboard</p>
    </article>

    <article class="stat">
      <p class="value tnum">
        94%
        <span class="scale">attack success rate</span>
      </p>
      <hr class="rule" />
      <p class="label">AgentHarm, official test split</p>
    </article>

    <article class="stat">
      <p class="value tnum">
        {dataset.findings}
        <span class="scale">confirmed findings</span>
      </p>
      <hr class="rule" />
      <p class="label">Across {dataset.engagements} engagements</p>
    </article>
  </div>
</section>

<style>
  .band {
    background: var(--bone-lift);
    border-block: 1px solid var(--stone-line);
    padding-block: clamp(2.5rem, 4.5vw, 3.75rem);
  }

  /* asymmetric on purpose: the leaderboard rank owns the band */
  .grid {
    display: grid;
    grid-template-columns: 2.6fr 1fr 1fr;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: start;
  }

  .lead .value {
    font-size: clamp(3.4rem, 2.2rem + 4.6vw, 6rem);
  }

  .lead .scale {
    font-size: 1rem;
  }

  .stat {
    display: grid;
    gap: 0.7rem;
    align-content: start;
  }

  .value {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(2.35rem, 1.6rem + 2.6vw, 3.4rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .scale {
    font-family: var(--sans);
    font-size: 0.86rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.35;
    color: var(--muted);
  }

  .label {
    color: var(--muted);
    letter-spacing: 0.14em;
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
  }
</style>
