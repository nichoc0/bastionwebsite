---
// Only pages that exist. No links to empty pages.
// /insurance is deliberately not here. It lives in the footer and gets sent
// as a direct link to carriers, so security buyers never wonder what we sell.
const links = [
  { href: '/platform', label: 'Platform' },
  { href: '/research', label: 'Research' },
  { href: '/corpus', label: 'Corpus' },
]
---

<header>
  <div class="page bar">
    <a class="mark" href="/">
      <span class="glyph"
        ><img src="/assets/bastion-mark.png" alt="" width="700" height="700" /></span
      >
      <span class="word">Bastion</span>
    </a>

    <nav aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <a class="btn btn-ghost cta" href="/contact">See how it fails</a>

    <!-- the same links on a phone, where the row nav is hidden. a native
         details disclosure, so it costs no JS and cannot trap content. -->
    <details class="mnav">
      <summary aria-label="Menu">
        <span class="bars" aria-hidden="true"></span>
      </summary>
      <div class="sheet">
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href="/contact">Contact</a>
      </div>
    </details>
  </div>
  <hr class="hairline" />
</header>

<style>
  header {
    background: var(--bone);
    position: sticky;
    top: 0;
    backdrop-filter: saturate(180%) blur(8px);
    background: rgba(16, 15, 13, 0.72);
    z-index: 10;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 4vw, 3rem);
    padding-block: 1.35rem;
  }

  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    margin-right: auto;
  }

  /* the mark is a 700x700 square whose artwork is a dome in the upper half,
     so the box is clipped to the artwork and the rest is pulled off-frame */
  .glyph {
    width: 42px;
    height: 22px;
    overflow: hidden;
    display: block;
    flex: none;
  }

  .glyph img {
    width: 42px;
    height: auto;
    margin-top: -7px;
  }

  .word {
    font-family: var(--display);
    font-size: 1.22rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  nav {
    display: flex;
    gap: clamp(1rem, 2.4vw, 2.1rem);
  }

  nav a {
    font-size: 0.925rem;
    text-decoration: none;
    color: var(--ink-2);
    transition: color 150ms ease;
  }

  nav a:hover {
    color: var(--gold-text);
  }

  .cta {
    padding: 0.6rem 1.05rem;
    font-size: 0.875rem;
  }

  .hairline {
    height: 1px;
    border: 0;
    margin: 0;
    background: linear-gradient(
      to right,
      transparent,
      var(--stone-line) 15%,
      var(--stone-line) 85%,
      transparent
    );
  }

  .mnav {
    display: none;
    position: relative;
  }

  .mnav summary {
    list-style: none;
    cursor: pointer;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--stone-line);
    border-radius: 3px;
  }

  .mnav summary::-webkit-details-marker {
    display: none;
  }

  .mnav[open] summary {
    border-color: var(--gold);
  }

  .bars {
    position: relative;
    width: 16px;
    height: 1px;
    background: var(--ink);
  }

  .bars::before,
  .bars::after {
    content: '';
    position: absolute;
    left: 0;
    width: 16px;
    height: 1px;
    background: var(--ink);
  }

  .bars::before {
    top: -5px;
  }

  .bars::after {
    top: 5px;
  }

  .sheet {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    min-width: 11rem;
    display: grid;
    padding: 0.45rem;
    background: var(--bone-lift);
    border: 1px solid var(--stone-line);
    border-radius: 4px;
    box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.55);
    z-index: 20;
  }

  .sheet a {
    padding: 0.7rem 0.9rem;
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--ink-2);
    border-radius: 3px;
  }

  .sheet a:hover {
    color: var(--gold-text);
    background: var(--panel);
  }

  @media (max-width: 860px) {
    nav {
      display: none;
    }
    .mnav {
      display: block;
    }
  }
</style>
