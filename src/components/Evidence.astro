---
const points = [
  'Every finding carries the transcript that produced it',
  'Severity and business impact on each one',
  'Mapped to the frameworks the reviewer already asks about',
  'Re-run on every deployment, so the evidence stays current',
]
---

<section class="section" id="evidence">
  <div class="page">
    <div class="head">
      <div>
        <p class="label">For teams shipping AI into enterprises</p>
        <h2>Know how your agent fails and fix it before someone else asks you</h2>
      </div>

      <div class="right">
        <p class="lede">
          We find it first and write it up in the language their reviewer
          already uses, so the deal stops waiting on it.
        </p>
        <ul class="points">{points.map((p) => <li>{p}</li>)}</ul>
        <div class="acts">
          <a class="btn btn-primary" href="/contact">See how it fails</a>
          <a
            class="btn btn-quiet"
            href="https://calendar.app.google/uUM1Mqos7uFRxfa67"
            target="_blank"
            rel="noopener noreferrer"
          >Book a call</a>
        </div>
      </div>
    </div>
    <!-- the console shot lives higher on the page now, in its own band
         after the engagement cases, and on /platform -->
  </div>
</section>

<style>
  .head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  h2 {
    font-size: clamp(1.75rem, 1.15rem + 2.2vw, 2.7rem);
    margin-top: 1.1rem;
    max-width: 17ch;
  }

  .points {
    list-style: none;
    margin: 1.6rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.8rem;
  }

  .points li {
    font-size: 0.94rem;
    line-height: 1.55;
    color: var(--ink-2);
    padding-left: 1.5rem;
    position: relative;
  }

  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.52em;
    width: 7px;
    height: 7px;
    border: 1px solid var(--gold);
    transform: rotate(45deg);
  }

  .acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.9rem;
  }

  @media (max-width: 860px) {
    .head {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
