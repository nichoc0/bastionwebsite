---
import { engagements } from '../data/engagements'
---

<section class="eng section">
  <div class="page">
    <div class="head">
      <div>
        <p class="label">From our engagements</p>
        <h2>We break Fortune 500 and leading startups shipping production AI</h2>
      </div>
      <div class="aside">
        <p class="note">
          Every case below is a confirmed finding from an authorized engagement,
          reported through official channels. Targets anonymized to their
          vertical, failure patterns only.
        </p>
        <a class="see" href="/research">Read the research →</a>
      </div>
    </div>

    <ol class="list">
      {
        engagements.map((e) => (
          <li class={`row sp${e.accent}`}>
            <span class="n">{e.n}</span>
            <div class="main">
              <h3>{e.title}</h3>
              <p class="body">{e.body}</p>
            </div>
            <div class="meta">
              <span class="tag">{e.tag}</span>
              <span class="vert">{e.vertical}</span>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .eng {
    background: var(--panel);
    border-block: 1px solid var(--stone-line);
  }

  .head {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    align-items: end;
    gap: 1.25rem 2.5rem;
    padding-bottom: 1.5rem;
    margin-bottom: clamp(0.5rem, 1.5vw, 1rem);
    border-bottom: 1px solid var(--stone-line);
  }

  h2 {
    font-size: clamp(1.5rem, 1.1rem + 1.7vw, 2.3rem);
    margin-top: 0.85rem;
    max-width: 20ch;
  }

  .aside {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
  }

  .note {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--muted);
    max-width: 40ch;
  }

  .see {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--gold-text);
    text-decoration: none;
  }

  .see:hover {
    color: var(--gold-lift);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* a numbered case row: index, the finding, then the class + vertical tags.
     the left rule carries the spectrum accent per row. */
  .row {
    display: grid;
    grid-template-columns: auto 1fr 15rem;
    gap: clamp(1rem, 3vw, 2.75rem);
    align-items: start;
    padding: clamp(1.4rem, 2.6vw, 2rem) 0 clamp(1.4rem, 2.6vw, 2rem)
      clamp(1rem, 2vw, 1.5rem);
    border-bottom: 1px solid var(--stone-line);
    border-left: 2px solid transparent;
    transition: border-left-color 200ms ease, background 200ms ease;
  }

  .row:hover {
    background: rgba(246, 240, 228, 0.02);
  }

  .sp1:hover { border-left-color: var(--sp-1); }
  .sp2:hover { border-left-color: var(--sp-2); }
  .sp3:hover { border-left-color: var(--sp-3); }
  .sp4:hover { border-left-color: var(--sp-4); }
  .sp5:hover { border-left-color: var(--sp-5); }

  .n {
    font-family: var(--display);
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.1rem);
    font-weight: 500;
    line-height: 1;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  h3 {
    font-size: clamp(1.15rem, 1rem + 0.85vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--ink);
    max-width: 26ch;
  }

  .body {
    margin-top: 0.7rem;
    font-size: 0.96rem;
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 62ch;
  }

  .meta {
    display: grid;
    gap: 0.55rem;
    justify-items: start;
    padding-top: 0.35rem;
  }

  .tag {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--gold-text);
  }

  .vert {
    font-size: 0.82rem;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .head {
      grid-template-columns: 1fr;
      align-items: start;
    }
    h2 {
      max-width: 22ch;
    }
    .row {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        'n main'
        'n meta';
      row-gap: 1rem;
      column-gap: 1.1rem;
    }
    .n {
      grid-area: n;
    }
    .main {
      grid-area: main;
    }
    .meta {
      grid-area: meta;
      grid-auto-flow: column;
      justify-content: start;
      align-items: baseline;
      gap: 0.65rem 1rem;
      flex-wrap: wrap;
    }
    .meta {
      display: flex;
    }
  }

  @media (max-width: 560px) {
    .row {
      grid-template-columns: 1fr;
      grid-template-areas:
        'n'
        'main'
        'meta';
      padding-left: 0;
      border-left: 0;
    }
    h3,
    .body {
      max-width: none;
    }
  }
</style>
