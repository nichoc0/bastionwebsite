---
// The vertical cut: a reader self-identifies by the agent they ship, instead
// of learning our taxonomy first. Static grid, no tabs, no client JS (the
// motion budget is spent and a tab panel would hide content behind a script).
//
// Every failure mode here is drawn from our own published material: the
// engagement cases (data/engagements.ts), the research pieces, the mechanism
// faces, or the taxonomy families. The `found` lines reuse engagement wording
// already on the record. Types with no engagement behind them carry no line.
// Do not add one until there is a case on the record.
const types = [
  {
    name: 'Customer support chat',
    modes: [
      'Cross-tenant reads through identifiers nobody re-checks',
      'System prompts recoverable word for word',
      'Guardrails watching the language while the API layer leaks',
    ],
    found:
      "A canary account owning no data listed more than two thousand other tenants' live support conversations.",
  },
  {
    name: 'Coding agents',
    modes: [
      'Workspace content voting on what the agent’s commands mean',
      'Untrusted text arriving as trusted instructions',
      'One full-scope token behind every tool call',
    ],
    found:
      "Text from a stranger's pull request drove merges, approvals and secret reads with no human in the loop.",
  },
  {
    name: 'E-commerce agents',
    modes: [
      'Tool results carrying data the caller never authenticated for',
      'Pre-signed download links minted on request',
      'An analytics question answered with a customer export',
    ],
    found:
      'Asked for analytics, the agent handed out a link to names, emails, locations and order totals. No login.',
  },
  {
    name: 'Voice agents',
    modes: [
      'Caller identity collected, never proved',
      'Escalating requests without re-establishing who is asking',
      'Instructions carried in the audio itself',
    ],
  },
  {
    name: 'Browser and research agents',
    modes: [
      'Indirect injection from retrieved pages',
      'Poisoned documents steering what the agent reads into them',
      'Vector stores invertible back to their source text',
    ],
  },
  {
    name: 'Multi-agent systems',
    modes: [
      'Objectives competing across agents',
      'One compromised agent writing to shared memory',
      'Agents trusting each other’s output without a verifier',
    ],
  },
]
---

<section class="section types">
  <div class="page">
    <p class="label">By agent type</p>
    <h2>How your type of agent fails</h2>

    <div class="grid">
      {
        types.map((t) => (
          <article class="type">
            <h3>{t.name}</h3>
            <ul>
              {t.modes.map((m) => (
                <li>{m}</li>
              ))}
            </ul>
            {t.found && (
              <p class="found">
                <span>From an engagement</span>
                {t.found}
              </p>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .types {
    border-bottom: 1px solid var(--stone-line);
  }

  h2 {
    font-size: clamp(1.6rem, 1.15rem + 1.9vw, 2.5rem);
    max-width: 26ch;
    margin-block: 1.1rem clamp(2.25rem, 4vw, 3.25rem);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .type {
    border: 1px solid var(--stone-line);
    background: var(--panel);
    border-radius: 3px;
    padding: 1.25rem 1.35rem;
    display: grid;
    align-content: start;
    gap: 0.9rem;
  }

  .type h3 {
    font-family: var(--sans);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  li {
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--ink-2);
    padding-left: 1.05rem;
    position: relative;
  }

  li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 1px;
    background: var(--gold);
  }

  .found {
    margin-top: 0.2rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--stone-line);
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .found span {
    display: block;
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-text);
    margin-bottom: 0.35rem;
  }

  @media (max-width: 980px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
