---
// Twelve faces, one mechanism each. Drag it in any direction. Click a face and
// it tells you the part of that mechanism that is not obvious.
import { mechanisms } from '../data/mechanisms'

// The read-out ships with the first mechanism server-rendered. Before this it
// was empty markup filled in by the script, so no-JS visitors and crawlers got
// a bare headline and an empty link.
const first = mechanisms[0]
---

<div class="solid">
  <div class="left">
    <div class="stage">
      <canvas></canvas>
    </div>
    <div class="pad">
      <button data-slot="0" aria-label="Neighbouring mechanism"></button>
      <button data-slot="1" aria-label="Neighbouring mechanism"></button>
      <button data-slot="2" aria-label="Neighbouring mechanism"></button>
      <button data-slot="3" aria-label="Neighbouring mechanism"></button>
      <button data-slot="4" aria-label="Neighbouring mechanism"></button>
    </div>
  </div>

  <aside class="read">
    <p class="face" data-face>{first.face}</p>
    <h3 data-title>{first.title}</h3>
    <p class="line" data-line>{first.line}</p>
    <a class="cite" data-cite href={first.url} target="_blank" rel="noopener noreferrer"
      >{first.cite} ↗</a
    >
  </aside>
</div>

<script is:inline define:vars={{ mechanisms }}>
  ;(() => {
    const root = document.currentScript.previousElementSibling
    const cv = root.querySelector('canvas')
    const ctx = cv.getContext('2d')
    const el = {
      face: root.querySelector('[data-face]'),
      title: root.querySelector('[data-title]'),
      line: root.querySelector('[data-line]'),
      cite: root.querySelector('[data-cite]'),
    }

    // dodecahedron. 20 vertices, and its 12 face centres are the dual's vertices
    const P = (1 + Math.sqrt(5)) / 2
    const ip = 1 / P
    const V = []
    for (const a of [-1, 1]) for (const b of [-1, 1]) for (const c of [-1, 1]) V.push([a, b, c])
    for (const a of [-1, 1]) for (const b of [-1, 1]) {
      V.push([0, a * ip, b * P]); V.push([a * ip, b * P, 0]); V.push([a * P, 0, b * ip])
    }
    // face normals. verified numerically: these are the only directions where
    // exactly five vertices tie for the maximum projection. the other
    // icosahedral orientation points at vertices, not faces.
    const C = []
    for (const a of [-1, 1]) for (const b of [-1, 1]) {
      C.push([0, a * P, b]); C.push([a * P, b, 0]); C.push([b, 0, a * P])
    }

    const len = (v) => Math.hypot(v[0], v[1], v[2])
    const norm = (v) => { const l = len(v); return [v[0] / l, v[1] / l, v[2] / l] }
    const sub = (a, b) => [a[0] - b[0], a[1] - b[1], a[2] - b[2]]
    const cross = (a, b) => [a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0]]
    const dot = (a, b) => a[0]*b[0] + a[1]*b[1] + a[2]*b[2]

    // each face is the five vertices nearest its centre, wound around the normal
    const FACES = C.map((c) => {
      const n = norm(c)
      // the five vertices of a face are the five with the largest projection
      // onto that face's normal. distance-to-centre picks the wrong set.
      const near = V.map((v, i) => ({ i, d: dot(v, n) }))
        .sort((a, b) => b.d - a.d).slice(0, 5).map((o) => o.i)
      // wind them by angle in the face plane. projecting onto that plane means
      // removing the normal component, not subtracting the unit normal.
      const planar = (v) => { const d = dot(v, n); return [v[0]-d*n[0], v[1]-d*n[1], v[2]-d*n[2]] }
      const u = norm(planar(V[near[0]]))
      const w = cross(n, u)
      const ang = (j) => { const q = planar(V[j]); return Math.atan2(dot(q, w), dot(q, u)) }
      near.sort((a, b) => ang(a) - ang(b))
      return { idx: near, n }
    })

    // two faces are adjacent when they share an edge, which means two vertices.
    // a pentagonal face therefore has exactly five neighbours, which is why a
    // four-way pad could never map onto it without skipping.
    const ADJ = FACES.map((f, i) =>
      FACES.map((g, j) => ({ j, shared: g.idx.filter((v) => f.idx.includes(v)).length }))
        .filter((o) => o.j !== i && o.shared === 2)
        .map((o) => o.j))

    let W = 0, H = 0, sel = 0, proj = []
    let q = [1, 0, 0, 0]

    const qmul = (a, b) => [
      a[0]*b[0] - a[1]*b[1] - a[2]*b[2] - a[3]*b[3],
      a[0]*b[1] + a[1]*b[0] + a[2]*b[3] - a[3]*b[2],
      a[0]*b[2] - a[1]*b[3] + a[2]*b[0] + a[3]*b[1],
      a[0]*b[3] + a[1]*b[2] - a[2]*b[1] + a[3]*b[0]]

    const qrot = (qq, v) => {
      const [w, x, y, z] = qq
      const t = [2*(y*v[2] - z*v[1]), 2*(z*v[0] - x*v[2]), 2*(x*v[1] - y*v[0])]
      return [v[0] + w*t[0] + (y*t[2] - z*t[1]),
              v[1] + w*t[1] + (z*t[0] - x*t[2]),
              v[2] + w*t[2] + (x*t[1] - y*t[0])]
    }

    const slerp = (a, b, t) => {
      let d = a[0]*b[0] + a[1]*b[1] + a[2]*b[2] + a[3]*b[3]
      let bb = b.slice()
      if (d < 0) { d = -d; bb = bb.map((v) => -v) }
      if (d > 0.9995) {
        const r = a.map((v, i) => v + (bb[i] - v) * t)
        const l = Math.hypot(...r); return r.map((v) => v / l)
      }
      const th = Math.acos(d), s0 = Math.sin((1 - t) * th) / Math.sin(th), s1 = Math.sin(t * th) / Math.sin(th)
      return a.map((v, i) => v * s0 + bb[i] * s1)
    }

    // the orientation that puts face i dead centre with a fixed roll, built as
    // an explicit basis and converted, so every direction behaves the same
    const matToQuat = (m) => {
      const tr = m[0][0] + m[1][1] + m[2][2]
      if (tr > 0) {
        const S = Math.sqrt(tr + 1) * 2
        return [S / 4, (m[2][1] - m[1][2]) / S, (m[0][2] - m[2][0]) / S, (m[1][0] - m[0][1]) / S]
      }
      if (m[0][0] > m[1][1] && m[0][0] > m[2][2]) {
        const S = Math.sqrt(1 + m[0][0] - m[1][1] - m[2][2]) * 2
        return [(m[2][1] - m[1][2]) / S, S / 4, (m[0][1] + m[1][0]) / S, (m[0][2] + m[2][0]) / S]
      }
      if (m[1][1] > m[2][2]) {
        const S = Math.sqrt(1 + m[1][1] - m[0][0] - m[2][2]) * 2
        return [(m[0][2] - m[2][0]) / S, (m[0][1] + m[1][0]) / S, S / 4, (m[1][2] + m[2][1]) / S]
      }
      const S = Math.sqrt(1 + m[2][2] - m[0][0] - m[1][1]) * 2
      return [(m[1][0] - m[0][1]) / S, (m[0][2] + m[2][0]) / S, (m[1][2] + m[2][1]) / S, S / 4]
    }

    const size = () => {
      const r = root.querySelector('.stage').getBoundingClientRect()
      const dpr = Math.min(devicePixelRatio || 1, 2)
      W = r.width; H = r.height
      cv.width = W * dpr; cv.height = H * dpr
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
    }

    const rot = (p) => qrot(q, p)

    const draw = () => {
      if (!W) return
      // a narrower factor on a phone keeps the widest vertices off the edges
      const R = Math.min(W, H) * (mq.matches ? 0.25 : 0.33)
      ctx.clearRect(0, 0, W, H)
      const cx = W / 2, cy = H / 2
      const pv = V.map((v) => {
        const [x, y, z] = rot(v)
        const k = 5.6 / (5.6 + z)
        return [cx + x * R * k, cy + y * R * k, z]
      })

      proj = FACES.map((f, i) => {
        const n = rot(f.n)
        const pts = f.idx.map((j) => pv[j])
        const depth = pts.reduce((s, p) => s + p[2], 0) / pts.length
        return { i, pts, facing: -n[2], depth }
      }).sort((a, b) => b.depth - a.depth)

      for (const f of proj) {
        const on = f.i === sel
        const lit = Math.max(0, f.facing)
        ctx.beginPath()
        ctx.moveTo(f.pts[0][0], f.pts[0][1])
        for (let k = 1; k < f.pts.length; k++) ctx.lineTo(f.pts[k][0], f.pts[k][1])
        ctx.closePath()

        ctx.fillStyle = on
          ? 'rgba(209,160,73,' + (0.1 + lit * 0.3) + ')'
          : 'rgba(246,240,228,' + (0.015 + lit * 0.075) + ')'
        ctx.fill()
        ctx.strokeStyle = on
          ? 'rgba(236,193,116,' + (0.4 + lit * 0.55) + ')'
          : 'rgba(246,240,228,' + (0.09 + lit * 0.34) + ')'
        ctx.lineWidth = on ? 1.9 : 1
        ctx.stroke()

        // on a phone the solid nearly fills the width, so a side face's label
        // clips at the edge. the chips already name the neighbours, so only the
        // centred face keeps its on-solid label there.
        if (lit > 0.4 && (!mq.matches || on)) {
          let mx = 0, my = 0
          for (const p of f.pts) { mx += p[0]; my += p[1] }
          mx /= f.pts.length; my /= f.pts.length
          ctx.globalAlpha = Math.min(1, (lit - 0.4) / 0.28)
          ctx.fillStyle = on ? '#f2d493' : 'rgba(240,235,222,0.82)'
          // line spacing follows the font, not the radius. R * 0.052 clamps to a
          // 10px floor while R keeps shrinking, so a radius-based gap collapses
          // the two lines onto each other on a phone.
          const fs = Math.max(10, R * 0.052)
          ctx.font = '600 ' + fs + 'px "Instrument Sans Variable", system-ui, sans-serif'
          ctx.textAlign = 'center'
          ctx.textBaseline = 'middle'
          const words = mechanisms[f.i].face.split(' ')
          for (let k = 0; k < words.length; k++) {
            ctx.fillText(words[k], mx, my + (k - (words.length - 1) / 2) * fs * 1.25)
          }
          ctx.globalAlpha = 1
          ctx.textAlign = 'left'
        }
      }
    }

    const show = () => {
      const m = mechanisms[sel]
      el.face.textContent = m.face
      el.title.textContent = m.title
      el.line.textContent = m.line
      el.cite.textContent = m.cite + ' ↗'
      el.cite.href = m.url
    }

    const inside = (pt, pts) => {
      let c = false
      for (let i = 0, j = pts.length - 1; i < pts.length; j = i++) {
        if ((pts[i][1] > pt[1]) !== (pts[j][1] > pt[1]) &&
          pt[0] < ((pts[j][0] - pts[i][0]) * (pt[1] - pts[i][1])) / (pts[j][1] - pts[i][1]) + pts[i][0]) c = !c
      }
      return c
    }

    const stage = root.querySelector('.stage')

    // the orientation that brings face n to dead centre, facing the camera.
    // derived rather than guessed: solve Rx(rx)*Ry(ry)*n = (0,0,-1).
    const orientTo = (i) => {
      const n = FACES[i].n
      const r0 = FACES[ADJ[i][0]].n
      const d = dot(r0, n)
      const rp = norm([r0[0] - d*n[0], r0[1] - d*n[1], r0[2] - d*n[2]])
      const zc = [-n[0], -n[1], -n[2]]
      const yc = [-rp[0], -rp[1], -rp[2]]
      const xc = cross(yc, zc)
      return matToQuat([xc, yc, zc])
    }

    let anim = null
    const goTo = (i) => {
      sel = i
      show()
      const target = orientTo(i)
      // assign from the orientation we are moving TO, not the one we are leaving
      const keep = q
      q = target
      assign()
      q = keep
      const from = q.slice()
      const t0 = performance.now()
      cancelAnimationFrame(anim)
      const step = (now) => {
        const k = Math.min(1, (now - t0) / 520)
        const e = 1 - Math.pow(1 - k, 3)
        q = slerp(from, target, e)
        draw()
        if (k < 1) anim = requestAnimationFrame(step)
      }
      anim = requestAnimationFrame(step)
    }

    // the five buttons sit at fixed pentagon points. each press goes to the
    // neighbour that actually lies in that direction on screen.
    const SLOTS = [-90, -18, 54, 126, 198].map((d) => (d * Math.PI) / 180)
    let slotFace = [0, 0, 0, 0, 0]

    // the ring of labels is wider than a phone, so below this width the buttons
    // stop being placed on the ring and flow as chips under the solid instead
    const mq = matchMedia('(max-width: 680px)')

    const assign = () => {
      const here = rot(FACES[sel].n)
      const cand = ADJ[sel].map((j) => {
        const n = rot(FACES[j].n)
        return { j, a: Math.atan2(n[1] - here[1], n[0] - here[0]) }
      })
      const free = cand.slice()
      slotFace = SLOTS.map((sa) => {
        let best = 0, bd = Infinity
        free.forEach((c, k) => {
          let d = Math.abs(((c.a - sa + Math.PI * 3) % (Math.PI * 2)) - Math.PI)
          if (d < bd) { bd = d; best = k }
        })
        return free.splice(best, 1)[0].j
      })
      const mobile = mq.matches
      const rad = Math.min(W, H) * 0.33 * 1.52
      root.querySelectorAll('[data-slot]').forEach((btn, k) => {
        btn.textContent = mechanisms[slotFace[k]].face
        btn.title = mechanisms[slotFace[k]].title
        // drop the absolute placement on mobile so the css chip flow takes over
        if (mobile) { btn.style.left = ''; btn.style.top = ''; return }
        const n = rot(FACES[slotFace[k]].n)
        const a = Math.atan2(n[1] - here[1], n[0] - here[0])
        btn.style.left = (W / 2 + Math.cos(a) * rad) + 'px'
        btn.style.top = (H / 2 + Math.sin(a) * rad) + 'px'
      })
    }

    root.querySelectorAll('[data-slot]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation()
        goTo(slotFace[+btn.dataset.slot])
      })
    })

    // clicking a face brings it round and selects it too
    stage.addEventListener('click', (e) => {
      if (e.target.closest('[data-turn]')) return
      const r = stage.getBoundingClientRect()
      const pt = [e.clientX - r.left, e.clientY - r.top]
      for (let k = proj.length - 1; k >= 0; k--) {
        if (proj[k].facing > 0 && inside(pt, proj[k].pts)) { goTo(proj[k].i); return }
      }
    })
    addEventListener('resize', () => { size(); assign(); draw() }, { passive: true })
    mq.addEventListener('change', () => { size(); assign(); draw() })

    size(); show()
    q = orientTo(sel)
    assign(); draw()
  })()
</script>

<style>
  .solid {
    display: grid;
    grid-template-columns: 1.02fr 0.98fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }

  .left {
    display: grid;
    gap: 0.25rem;
    position: relative;
  }

  .stage {
    position: relative;
    aspect-ratio: 1 / 0.95;
    min-height: 420px;
  }

  /* five buttons on a pentagon, one per edge of the face you are on */
  .pad {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* the neighbour chips are labelled by the script. without JS they stay
     empty, and an empty chip is noise, so it hides itself. */
  .pad button:empty {
    display: none;
  }

  .pad button {
    position: absolute;
    transform: translate(-50%, -50%);
    pointer-events: auto;
    white-space: nowrap;
    padding: 0.42rem 0.7rem;
    font-family: var(--sans);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.2;
    color: var(--ink-2);
    background: var(--panel);
    border: 1px solid var(--stone-line);
    border-radius: 3px;
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease, background 150ms ease;
  }

  .pad button:hover {
    color: #14130f;
    background: var(--gold-lift);
    border-color: var(--gold-lift);
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .read {
    border-left: 1px solid var(--stone-line);
    padding-left: clamp(1.25rem, 2.5vw, 2rem);
  }

  .face {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-text);
  }

  h3 {
    font-size: clamp(1.3rem, 1.05rem + 1.1vw, 1.95rem);
    margin-block: 0.75rem 0.9rem;
    max-width: 22ch;
  }

  .line {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--ink-2);
    max-width: 48ch;
  }

  .cite {
    display: inline-block;
    margin-top: 1.1rem;
    font-size: 0.8rem;
    color: var(--muted);
    text-decoration: none;
  }

  .cite:hover {
    color: var(--gold-text);
  }

  @media (max-width: 900px) {
    .solid {
      grid-template-columns: 1fr;
    }
    .read {
      border-left: 0;
      border-top: 1px solid var(--stone-line);
      padding: 1.25rem 0 0;
    }
  }

  /* on a phone the ring does not fit, so the neighbour buttons drop out of the
     ring and flow as a wrapped row of chips directly under the solid */
  @media (max-width: 680px) {
    /* a fixed height, not an aspect-ratio: deriving width from height
       (320 / 0.82 = 390) forced the grid track wider than the phone and cut
       off the chips and the read-out on the right */
    .stage {
      aspect-ratio: auto;
      min-height: 0;
      height: 330px;
    }
    .left,
    .read {
      min-width: 0;
    }
    .pad {
      position: static;
      inset: auto;
      pointer-events: auto;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 0.9rem;
    }
    .pad button {
      position: static;
      transform: none;
      font-size: 0.78rem;
    }
  }
</style>
